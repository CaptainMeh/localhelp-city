---
/**
 * The service overview: what you can actually ask us about.
 * Highly scannable — a visitor should grasp the breadth of the
 * service in about ten seconds. Real categories, no "solutions".
 */
import { WA_MESSAGES, waLink } from '../lib/site';

interface Service {
  icon: string;
  title: string;
  body: string;
  href: string;
  linkLabel: string;
  external?: boolean;
}

const services: Service[] = [
  {
    icon: '🏠',
    title: 'Housing & renting',
    body: 'Neighborhoods, viewings, contracts, deposits, landlord questions.',
    href: '/cluj/housing-help/',
    linkLabel: 'Housing help',
  },
  {
    icon: '🔍',
    title: 'Listing & rent checks',
    body: 'Send a listing — we tell you if it looks real and if the price is fair.',
    href: waLink(WA_MESSAGES.housing),
    linkLabel: 'Send a listing',
    external: true,
  },
  {
    icon: '📄',
    title: 'Paperwork & offices',
    body: 'The right documents, the right office, prepared the first time.',
    href: '/cluj/paperwork-help/',
    linkLabel: 'Paperwork help',
  },
  {
    icon: '🧳',
    title: 'Arrival & first week',
    body: 'SIM, transport, groceries, registrations — in the right order.',
    href: '/cluj/foreigner-support/',
    linkLabel: 'Plan your arrival',
  },
  {
    icon: '🧭',
    title: 'Everyday life & services',
    body: 'Doctors, dentists, banks, gyms, repairs — and what things should cost.',
    href: waLink(WA_MESSAGES.general),
    linkLabel: 'Ask about anything local',
    external: true,
  },
  {
    icon: '🧯',
    title: 'Confusing situations',
    body: 'A strange letter, a dispute, a lost ID — we help you find the next step.',
    href: '/how-it-works/',
    linkLabel: 'How it works',
  },
  {
    icon: '🤝',
    title: 'In-person help',
    body: 'Viewings, offices, meetings — by the hour, agreed in advance.',
    href: '/cluj/pricing/',
    linkLabel: 'How it’s priced',
  },
  {
    icon: '💬',
    title: 'Something else?',
    body: 'Ask anyway. If we can’t help, we’ll say so and point you to someone who can.',
    href: waLink(WA_MESSAGES.general),
    linkLabel: 'Just message us',
    external: true,
  },
];
---

<div class="grid gap-3 sm:gap-4 mt-10 grid-cols-2 lg:grid-cols-4">
  {
    services.map((s) => (
      <a
        href={s.href}
        rel={s.external ? 'noopener' : undefined}
        class="group bg-cream rounded-2xl p-4 sm:p-5 border border-terra-soft/60 hover:border-terra hover:-translate-y-0.5 transition-all flex flex-col"
      >
        <span class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-honey-soft flex items-center justify-center text-lg sm:text-xl" aria-hidden="true">
          {s.icon}
        </span>
        <h3 class="font-semibold text-base sm:text-lg mt-3 leading-snug">{s.title}</h3>
        <p class="mt-1.5 text-ink-soft text-sm sm:text-[0.93rem] flex-1">{s.body}</p>
        <span class="mt-3 text-sm font-semibold text-terra-deep group-hover:underline underline-offset-4">
          {s.linkLabel} →
        </span>
      </a>
    ))
  }
</div>
