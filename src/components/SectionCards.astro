---
/** Grid of soft cards: emoji/icon, title, body (and optional link). */
interface Card {
  icon?: string;
  title: string;
  body: string;
  href?: string;
  linkLabel?: string;
}
interface Props {
  cards: Card[];
  columns?: 2 | 3;
}
const { cards, columns = 3 } = Astro.props;
---

<div class:list={['grid gap-5 mt-10', columns === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2']}>
  {
    cards.map((card) => (
      <div class="bg-cream border border-terra-soft rounded-2xl p-6 flex flex-col">
        <h3 class="font-semibold text-xl">
          {card.icon && <span class="mr-2" aria-hidden="true">{card.icon}</span>}
          {card.title}
        </h3>
        <p class="mt-3 text-ink-soft flex-1">{card.body}</p>
        {card.href && (
          <a href={card.href} class="mt-4 font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">
            {card.linkLabel ?? 'Read more'} →
          </a>
        )}
      </div>
    ))
  }
</div>
