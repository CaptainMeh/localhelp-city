---
/** Full-width warm closing CTA. */
import WhatsAppButton from './WhatsAppButton.astro';
import { WA_MESSAGES } from '../lib/site';

interface Props {
  headline: string;
  message?: string;
  label?: string;
  secondaryMessage?: string;
  secondaryLabel?: string;
}
const {
  headline,
  message = WA_MESSAGES.general,
  label = 'Ask us one question',
  secondaryMessage,
  secondaryLabel,
} = Astro.props;
---

<section class="bg-terra-soft/60 border-y border-terra-soft mt-16 md:mt-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16 text-center" data-reveal>
    <h2 class="text-3xl md:text-4xl font-semibold">{headline}</h2>
    <div class="mt-4 text-lg text-ink-soft max-w-2xl mx-auto space-y-3">
      <slot />
    </div>
    <div class="mt-7 flex flex-wrap gap-3 justify-center">
      <WhatsAppButton message={message} label={label} variant="primary" />
      {secondaryMessage && secondaryLabel && (
        <WhatsAppButton message={secondaryMessage} label={secondaryLabel} variant="secondary" />
      )}
    </div>
    <p class="mt-4 text-sm text-ink-soft">
      <slot name="footnote" />
    </p>
  </div>
</section>
