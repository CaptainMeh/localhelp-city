---
/** Team / office trust block. Concrete, understated, the service is the point, not the team. */
interface Props {
  title?: string;
  compact?: boolean;
}
const { title = 'The people who answer', compact = false } = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 mt-14 md:mt-20">
  <div class="grid gap-10 md:grid-cols-2 items-center" data-reveal>
    <div>
      <h2 class="text-3xl md:text-4xl font-semibold">{title}</h2>
      <div class="mt-4 text-ink-soft text-lg space-y-4">
        <slot>
          <p>
            We're a small local team with an office in the centre of Cluj-Napoca, not a
            platform, an app, or a call center. When you message, a real person who lives
            here reads it and answers.
          </p>
          <p>
            <strong class="text-ink">Michael is usually the one who answers.</strong> He's from
            Cluj, studied at several universities here and abroad, and is the person friends
            call when something needs to get sorted.
          </p>
        </slot>
      </div>
      {!compact && (
        <a href="/about/" class="inline-block mt-5 font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">
          More about us →
        </a>
      )}
    </div>
    <figure>
      <div class="rounded-3xl overflow-hidden">
        <img
          src="/images/team.webp"
          alt="The team around a laptop at our office in Piața Muzeului, Cluj"
          class="w-full h-auto"
          loading="lazy"
          width="1400"
          height="870"
        />
      </div>
      <figcaption class="mt-2.5 text-sm text-ink-soft italic">A real afternoon at our office in Piața Muzeului, central Cluj.</figcaption>
    </figure>
  </div>
</section>
