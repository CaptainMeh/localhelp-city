---
/**
 * The localhelp.city wordmark as an SVG logo.
 * variant "default": brand colors for light backgrounds (header).
 * variant "footer": cream + honey for the dark espresso footer.
 */
interface Props {
  size?: 'base' | 'lg';
  variant?: 'default' | 'footer';
}
const { size = 'base', variant = 'default' } = Astro.props;
const fills =
  variant === 'footer'
    ? { word: 'var(--color-cream)', city: 'var(--color-honey)' }
    : { word: '#173A2D', city: '#C95732' };
---

