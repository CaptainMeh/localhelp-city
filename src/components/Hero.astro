---
/**
 * Page hero: kicker, headline, lead, CTAs (via slot), optional image.
 */
interface Props {
  kicker?: string;
  headline: string;
  /** Optional highlighted core sentence under the lead. */
  coreSentence?: string;
  image?: { src: string; alt: string; width?: number; height?: number };
}
const { kicker, headline, coreSentence, image } = Astro.props;
---

<section class="bg-paper border-b border-terra-soft">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <div class:list={['grid gap-10 items-center', image ? 'md:grid-cols-2' : 'max-w-3xl']}>
      <div>
        {kicker && <p class="text-terra-deep font-semibold uppercase tracking-wide text-sm mb-3">{kicker}</p>}
        <h1 class="text-4xl md:text-5xl font-semibold">{headline}</h1>
        <div class="mt-5 text-lg text-ink-soft space-y-4">
          <slot name="lead" />
        </div>
        {
          coreSentence && (
            <p class="mt-5 font-display text-xl text-ink border-l-4 border-honey pl-4">
              {coreSentence}
            </p>
          )
        }
        <div class="mt-7 flex flex-wrap gap-3 items-center">
          <slot name="cta" />
        </div>
        <div class="mt-3 text-sm text-ink-soft">
          <slot name="reassurance" />
        </div>
      </div>
      {
        image && (
          <div class="rounded-2xl overflow-hidden border border-terra-soft bg-cream">
            <img src={image.src} alt={image.alt} class="w-full h-auto" loading="eager" width={image.width ?? 800} height={image.height ?? 600} />
          </div>
        )
      }
    </div>
  </div>
</section>
