---
/**
 * Accessible FAQ accordion (no JavaScript — <details>/<summary>).
 * Set withSchema to emit FAQPage JSON-LD built from the same items,
 * so schema always mirrors visible content.
 */
interface Item {
  q: string;
  a: string; // plain text (used in schema); simple sentences only
}
interface Props {
  items: Item[];
  withSchema?: boolean;
}
const { items, withSchema = false } = Astro.props;

const schema = withSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;
---

<div class="mt-8 divide-y divide-terra-soft border-y border-terra-soft" data-reveal>
  {
    items.map((item) => (
      <details class="py-3.5 group">
        <summary class="font-semibold text-lg pr-8">{item.q}</summary>
        <p class="mt-3 text-ink-soft max-w-2xl">{item.a}</p>
      </details>
    ))
  }
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
