---
/** Visible breadcrumb trail + BreadcrumbList JSON-LD (kept in sync from one prop). */
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  items: { name: string; path: string }[]; // includes the current page as last item
}
const { items } = Astro.props;
const schema = breadcrumbSchema(items);
---

<nav aria-label="Breadcrumb" class="max-w-6xl mx-auto px-4 sm:px-6 pt-4">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-ink-soft">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true" class="text-terra-soft">›</span>}
          {i < items.length - 1 ? (
            <a href={item.path} class="hover:text-terra-deep underline-offset-4 hover:underline">
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class="text-ink font-medium">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
