---
/** Thin strip of trust facts. Defaults to the Cluj set. */
interface Props {
  items?: string[];
}
const {
  items = [
    '📍 Office in central Cluj-Napoca',
    '🎓 Led by a local PhD',
    '💬 English & Romanian',
    '👥 A small, real team',
  ],
} = Astro.props;
---

<div class="bg-cream border-b border-terra-soft">
  <ul class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap gap-x-8 gap-y-1.5 text-sm text-ink-soft">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>
