---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import { WA_MESSAGES } from '../../../lib/site';
import { localBusinessSchema } from '../../../lib/schema';

/**
 * No guides are published yet, so this page stays honest and minimal:
 * what's coming, in what order, and the faster alternative (asking us).
 * When the first real guide is live, list it here properly — no
 * "coming soon" card walls.
 */
const upcomingTopics = [
  'How to avoid rental scams in Cluj-Napoca',
  'Best neighborhoods in Cluj for students',
  'Apartment viewing checklist',
  'Rental contracts in Romania, explained simply',
  'How much does rent cost in Cluj?',
  'Your first week in Cluj: the complete checklist',
  'Public transport, SIM cards, and bank accounts',
  'Student paperwork and residence-permit preparation',
];
---

<BaseLayout
  title="Guides to Life in Cluj — Honest, Local, Free"
  description="Free practical guides to living in Cluj-Napoca are being written now — housing first. Until yours is published, the answer is one WhatsApp message away."
  path="/cluj/guides/"
  schema={[localBusinessSchema()]}
>
  <Hero headline="Guides to life in Cluj — honest, local, free.">
    <Fragment slot="lead">
      <p>
        We're writing practical guides about the things people new to Cluj actually struggle
        with — free, whether you ever pay us or not. Written by the same people who answer your
        messages, starting with housing.
      </p>
      <p>
        <strong class="text-ink">The first guides are being written now.</strong> Until yours is
        up, the answer is one message away — and it'll be about <em>your</em> listing,
        <em>your</em> paperwork, <em>your</em> street, not the general case.
      </p>
    </Fragment>
    <Fragment slot="cta">
      <WhatsAppButton message={WA_MESSAGES.general} label="Ask us one question" variant="primary" />
    </Fragment>
    <Fragment slot="reassurance">A real person replies, usually within a few hours.</Fragment>
  </Hero>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 mt-16">
    <h2 class="text-3xl font-semibold">What's coming first</h2>
    <ul class="mt-6 columns-1 sm:columns-2 gap-8 space-y-2.5 text-ink-soft">
      {upcomingTopics.map((t) => (
        <li class="break-inside-avoid flex gap-2.5">
          <span class="text-honey" aria-hidden="true">✍️</span>
          <span>{t}</span>
        </li>
      ))}
    </ul>
  </section>

  <CtaBlock
    headline="Need one of these answers today?"
    message={WA_MESSAGES.general}
    label="Ask us one question"
  >
    <p>A guide is general; your situation isn't. Message us the specifics.</p>
    <Fragment slot="footnote">If the answer helped, pay what feels fair while we're new.</Fragment>
  </CtaBlock>
</BaseLayout>
