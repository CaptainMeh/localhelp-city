---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionCards from '../../components/SectionCards.astro';
import ChatExample from '../../components/ChatExample.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import PaymentExplainer from '../../components/PaymentExplainer.astro';
import { WA_MESSAGES } from '../../lib/site';
import { serviceSchema } from '../../lib/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const questions = [
  '"Is this listing real, or is it a scam?"',
  '"Is €400 normal for a one-bedroom near UMF?"',
  '"Which neighborhood actually makes sense for me?"',
  '"What do I even ask at an apartment viewing?"',
  '"What does this clause in my contract mean?"',
  '"Where do I go for this stamp / paper / registration?"',
  '"Where\'s a dentist who speaks English?"',
  '"My landlord says X. Is that normal here?"',
  '"I lost my ID. What now?"',
];

const helpCards = [
  {
    icon: '🏠',
    title: 'Housing & renting',
    body: "Is this listing safe? Is the rent fair? Which neighborhood suits you? What to ask at a viewing, what's normal in contracts and deposits, what to do when something breaks or the landlord surprises you.",
    href: '/cluj/housing-help/',
    linkLabel: 'Housing help',
  },
  {
    icon: '📄',
    title: 'Paperwork & offices',
    body: 'Which documents you actually need, which office handles what, how appointments and queues work here, and what to prepare so one trip is enough.',
    href: '/cluj/paperwork-help/',
    linkLabel: 'Paperwork help',
  },
  {
    icon: '💳',
    title: 'Money & getting set up',
    body: 'Opening a bank account, choosing a SIM card, setting up utilities, where students shop without overpaying, roughly what things should cost.',
  },
  {
    icon: '🩺',
    title: 'Health & wellbeing basics',
    body: 'Finding a family doctor, dentist, pharmacy, or therapist, including ones who speak English. (We help you find care; we never give medical advice.)',
  },
  {
    icon: '🚌',
    title: 'Getting around & daily life',
    body: 'Public transport, the apps students actually use, gyms, salons, repair shops, barbers, where to buy what, the small daily decisions that add up.',
  },
  {
    icon: '😰',
    title: 'When something goes wrong',
    body: "Lost documents, a dispute with a landlord, a billing mistake, a situation you don't understand. We help you figure out what to do next and who can actually help. (Real emergencies: always call 112 first.)",
  },
];
---

<BaseLayout
  title="Student Support in Cluj-Napoca"
  description="Practical support for students in Cluj: housing, paperwork, budgets, and everyday student life. Ask a real local person on WhatsApp, in English."
  path="/cluj/student-support/"
  schema={[serviceSchema({ name: 'Student support in Cluj-Napoca', description: 'Practical local guidance for students in Cluj: housing, paperwork, budgets, everyday life, on WhatsApp.', path: '/cluj/student-support/' })]}
>
  <Breadcrumbs items={[{ name: 'Cluj', path: '/cluj/' }, { name: 'Student support', path: '/cluj/student-support/' }]} />
  <Hero
    kicker="For students in Cluj"
    headline="Student support in Cluj-Napoca"
    image={{ src: '/images/moving-in.webp', alt: 'Two people unpacking moving boxes in a bright apartment', width: 1400, height: 766 }}
  >
    <Fragment slot="lead">
      <p class="font-display text-xl text-ink">Someone local to ask, before you sign, pay, or panic.</p>
      <p>
        New at UBB, UMF, UTCN, or USAMV, or moving to Cluj from another Romanian city? We're a
        real local team on WhatsApp for all the small, confusing parts of student life here:
        housing, paperwork, neighborhoods, everyday decisions.
      </p>
      <p>
        We're just starting in Cluj, so early users pay what feels fair. Ask us a real question,
        use the answer, and if it helped, pay what you think it was worth.
      </p>
    </Fragment>
    <Fragment slot="cta">
      <WhatsAppButton message={WA_MESSAGES.student} label="Ask us one question" variant="primary" />
      <a href="/how-it-works/" class="btn-fx inline-flex items-center gap-2 border-2 border-terra text-terra-deep hover:bg-terra-soft font-semibold rounded-full px-7 py-3">
        See how it works
      </a>
    </Fragment>
    <Fragment slot="reassurance">A real person replies, usually within a few hours.</Fragment>
  </Hero>

  <TrustStrip />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20">
    <PageIntro title="Moving to Cluj isn't one big problem. It's fifty small ones.">
      <p>
        Nobody warns you about the small stuff. The apartment listing that looks great but feels
        slightly off. The deposit that might be normal, or might not. The office that needed a
        document nobody mentioned. The neighborhood names that mean nothing to you yet. Each
        thing is small. Together, in a new city, in a language you may not speak, they're
        exhausting.
      </p>
      <p class="font-medium text-ink">The questions we hear every week:</p>
    </PageIntro>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {questions.map((q) => (
        <li class="bg-cream border border-terra-soft rounded-2xl rounded-bl-sm px-4 py-3 text-ink-soft text-[0.95rem]">{q}</li>
      ))}
    </ul>
    <p class="mt-6 text-lg text-ink-soft">
      If you've asked yourself any of these, you're exactly who we built this for.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20">
    <div class="grid gap-10 md:grid-cols-2 items-start">
      <PageIntro title="Ask someone local. It really is that simple.">
        <p>
          Every city runs on local knowledge, the stuff people who grew up here just know. When
          you're new, you don't have it yet. We do. So instead of guessing, googling, or hoping a
          Facebook group is right, you message us.
        </p>
        <p>
          A real person who knows Cluj tells you what's normal, what to check, and what they'd do
          next. And if a situation is easier with a local physically there, a viewing, an office,
          we can often come along, by the hour, agreed in advance.
        </p>
      </PageIntro>
      <div class="md:pt-14">
        <ChatExample
          question="Hi! Found a studio in Mănăștur, 320€, landlord wants 2 months deposit + first month before viewing. Normal?"
          answer="Paying anything before a viewing is a red flag here, please don't send money yet. Two months' deposit happens in Cluj but it's on the higher side. Send us the listing? We'll take a look and tell you what we'd check at the viewing."
        />
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20">
    <PageIntro title="The everyday stuff of student life in Cluj">
      <p>Not sure your question fits a category? Ask anyway. If we can't help, we'll say so honestly, and point you toward someone who can.</p>
    </PageIntro>
    <SectionCards cards={helpCards} columns={3} />
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 mt-16">
    <p class="text-lg text-ink-soft">
      Worth reading in your first weeks: our guides to
      <a href="/cluj/guides/public-transport-cluj/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">public transport and student passes</a>,
      <a href="/cluj/guides/open-bank-account-romania-foreigner/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">opening a Romanian bank account</a>, and
      <a href="/cluj/guides/romanian-sim-card-foreigners/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">getting a Romanian SIM</a>.
    </p>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 mt-16">
    <PaymentExplainer full={false} />
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 mt-20">
    <PageIntro title="Your parents will like this too">
      <p>
        If your parents worry (they do), there's a page written for them: what we are, what we're
        not, and how we respect your independence, we work with you directly and in confidence,
        not as anyone's eyes in Cluj.
      </p>
      <p>
        <a href="/cluj/for-parents/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">Read the page for parents →</a>
      </p>
    </PageIntro>
  </section>

  <CtaBlock
    headline="You don't have to figure out Cluj alone."
    message={WA_MESSAGES.student}
    label="Ask us one question"
    secondaryMessage={WA_MESSAGES.student}
    secondaryLabel="Get local guidance"
  >
    <p>
      Thousands of students arrive in this city every autumn and learn everything the hard way.
      You don't have to. Before you sign, pay, book, visit, decide, or panic — ask someone local.
    </p>
    <Fragment slot="footnote">If the answer helped, pay what feels fair. Small questions are the job.</Fragment>
  </CtaBlock>
</BaseLayout>
