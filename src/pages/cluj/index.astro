---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionCards from '../../components/SectionCards.astro';
import ChatExample from '../../components/ChatExample.astro';
import TeamSection from '../../components/TeamSection.astro';
import HonestLimits from '../../components/HonestLimits.astro';
import GuideCard from '../../components/GuideCard.astro';
import Faq from '../../components/Faq.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SITE, WA_MESSAGES } from '../../lib/site';
import { localBusinessSchema } from '../../lib/schema';

const whoCards = [
  {
    icon: '🎓',
    title: 'Students',
    body: 'New at UBB, UMF, UTCN, USAMV — or moving to Cluj from another Romanian city. Housing, paperwork, budgets, and the first-semester scramble.',
    href: '/cluj/student-support/',
    linkLabel: 'Student support in Cluj',
  },
  {
    icon: '🌍',
    title: 'New to Cluj — from abroad or anywhere',
    body: "Maybe you're here with a job offer, with your family, with a laptop for a season, or starting a whole new life. Different stories, same fifty questions.",
    href: '/cluj/foreigner-support/',
    linkLabel: 'Someone local to ask in Cluj',
  },
  {
    icon: '❤️',
    title: 'Parents',
    body: "Your child is moving here and you'd sleep better knowing they have someone local to ask. So would they, honestly.",
    href: '/cluj/for-parents/',
    linkLabel: 'For parents',
  },
];

const helpCards = [
  {
    icon: '🏠',
    title: 'Housing & renting',
    body: "Is the listing safe? Is the rent fair? Which neighborhood suits you? What to ask at a viewing, what's normal in contracts and deposits, what to do when the landlord surprises you.",
    href: '/cluj/housing-help/',
    linkLabel: 'Housing help',
  },
  {
    icon: '📄',
    title: 'Paperwork & offices',
    body: 'Which documents you need, which office handles what, how appointments work here, and how to prepare so one trip is enough.',
    href: '/cluj/paperwork-help/',
    linkLabel: 'Paperwork help',
  },
  {
    icon: '💳',
    title: 'Money & getting set up',
    body: 'Bank account, SIM card, utilities, where locals shop without overpaying, what things should roughly cost.',
  },
  {
    icon: '🩺',
    title: 'Health & wellbeing basics',
    body: 'Finding a family doctor, dentist, pharmacy, or therapist — including ones who speak English. (We help you find care; we never give medical advice.)',
  },
  {
    icon: '🚌',
    title: 'Getting around & daily life',
    body: 'Transport, the apps locals actually use, gyms, salons, repairs, the small daily decisions that add up.',
  },
  {
    icon: '😰',
    title: 'When something goes wrong',
    body: "Lost documents, a landlord dispute, a bill that looks wrong, a situation you don't understand. We help you find the next step. (Real emergencies: call 112 first, always.)",
  },
];

const guidePreviews = [
  {
    title: 'How to avoid rental scams in Cluj-Napoca',
    description: 'The red flags we see every month, and the golden rule that prevents most disasters.',
  },
  {
    title: 'Best neighborhoods in Cluj for students',
    description: 'Honest pros and cons, by university and budget — including the trade-offs listing sites skip.',
  },
  {
    title: 'Your first week in Cluj: the complete checklist',
    description: 'Everything to set up, in order, without panic — SIM, transport, groceries, registration.',
  },
];

const faqItems = [
  {
    q: 'How does "pay what feels fair" actually work?',
    a: "Exactly like it sounds. You ask, we answer properly, and afterwards we send a payment link with a suggested range for that kind of help. You choose the amount. We're new in Cluj — this is how we'd rather earn trust than with a paywall.",
  },
  {
    q: 'Do I have to pay before asking?',
    a: "No. While we're new in Cluj, you can ask first. If the answer helped, we'll send a payment link with a suggested range, and you choose what feels fair.",
  },
  {
    q: 'Can you find me an apartment?',
    a: "Not quite — we're not an agency and we don't have listings. What we do is make you good at finding one: we review listings you find, flag scams, tell you if prices are fair, help you choose a neighborhood, prep you for viewings, and help you understand the contract before you sign.",
  },
  {
    q: 'Is this only for students?',
    a: "Students are where we started and they keep a special place here — but we're for anyone new in Cluj: internationals, newcomers, and everyone in between. Same warm deal for everyone.",
  },
  {
    q: 'When is a price agreed in advance?',
    a: "Twice, always: anything complex enough to take real hours, and all in-person help (by the hour). If we haven't agreed it in advance, you don't owe it.",
  },
  {
    q: 'How quickly do you reply?',
    a: "During the day, usually within a few hours — often faster. We're a small team that prioritizes time-sensitive things, so tell us when something is urgent-ish. We're not an emergency line: in any real emergency, call 112 first.",
  },
];
---

<BaseLayout
  title="New in Cluj? Someone Local to Ask"
  description="Someone local when Cluj gets confusing. Practical, English-speaking guidance for students, internationals, and newcomers in Cluj-Napoca — on WhatsApp. Ask a question, pay what feels fair."
  path="/cluj/"
  schema={[localBusinessSchema()]}
>
  <Hero headline="New in Cluj? You know someone here now." coreSentence={SITE.coreSentence}>
    <Fragment slot="lead">
      <p>
        Whatever brought you to Cluj — university, a job, a person, a plan, a fresh start — the
        city works the same way for everyone at the beginning: fifty small confusing things, all
        at once, in a language you may not speak yet.
      </p>
      <p>
        We're a small local team in the centre of Cluj. You can ask us the everyday questions of
        living here, on WhatsApp, in English: <em>Is this rent normal? Is this listing real?
        Which neighborhood? What documents? Where do I even go for this?</em>
      </p>
      <p>
        And because we're just starting in Cluj, <strong class="text-ink">early users pay what
        feels fair</strong> — ask us a real question, use the answer, and if it helped, pay what
        you think it was worth.
      </p>
    </Fragment>
    <Fragment slot="cta">
      <WhatsAppButton message={WA_MESSAGES.general} label="Ask us one question" variant="primary" />
      <WhatsAppButton message={WA_MESSAGES.general} label="Get local guidance" variant="secondary" />
    </Fragment>
    <Fragment slot="reassurance">A real person replies, usually within a few hours.</Fragment>
  </Hero>

  <TrustStrip />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20">
    <PageIntro title="Who it's for">
      <p>One kind of help, three front doors. Pick yours — or don't; nobody fits boxes perfectly. Just message us.</p>
    </PageIntro>
    <SectionCards cards={whoCards} columns={3} />
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20">
    <PageIntro title="The everyday stuff we help with">
      <p>
        Not sure your question fits? Ask anyway. If we can't help, we'll say so honestly — and
        point you to someone who can.
      </p>
    </PageIntro>
    <SectionCards cards={helpCards} columns={3} />
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20">
    <div class="grid gap-10 md:grid-cols-2 items-start">
      <PageIntro title="How it works">
        <ol class="space-y-4 list-none">
          <li><strong class="text-ink">1. Message us on WhatsApp.</strong> Any everyday question about living in Cluj.</li>
          <li><strong class="text-ink">2. A local answers.</strong> Not a bot, not a script — a person who lives here, with practical advice and honest limits.</li>
          <li><strong class="text-ink">3. If it helped, pay what feels fair.</strong> We send a payment link with a suggested range, and you choose. Bigger jobs we agree on together before starting.</li>
          <li><strong class="text-ink">4. Want someone there in person?</strong> Viewings, offices, meetings — we can often come along. By the hour, price agreed in advance, always your call.</li>
        </ol>
        <p><a href="/how-it-works/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">More about how it works →</a></p>
      </PageIntro>
      <div class="md:pt-14">
        <ChatExample
          question="Hi! Found a studio in Mănăștur, 320€, landlord wants two months' deposit + first month before viewing. Normal?"
          answer="Paying anything before a viewing is a red flag here — please don't send money yet. Two months' deposit happens in Cluj but it's on the higher side. Send us the listing? We'll tell you what we'd check."
        />
      </div>
    </div>
  </section>

  <TeamSection />

  <HonestLimits />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-20">
    <PageIntro title="Free guides to life in Cluj">
      <p>Honest, practical guides about the things people actually struggle with here — free, whether you ever pay us or not.</p>
    </PageIntro>
    <div class="grid gap-5 mt-10 sm:grid-cols-2 lg:grid-cols-3">
      {guidePreviews.map((g) => <GuideCard title={g.title} description={g.description} comingSoon />)}
    </div>
    <a href="/cluj/guides/" class="inline-block mt-6 font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">
      View all guides →
    </a>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 mt-20">
    <PageIntro title="Common questions" />
    <Faq items={faqItems} withSchema />
  </section>

  <CtaBlock
    headline="You don't have to figure out Cluj alone."
    message={WA_MESSAGES.general}
    label="Ask us one question"
  >
    <p>
      Every autumn and every Monday, someone new arrives in this city and learns everything the
      hard way. You don't have to. There's someone local when Cluj gets confusing — and while
      we're new, you decide what our help was worth.
    </p>
    <Fragment slot="footnote">One question, one honest local answer. If it helped, pay what feels fair. That's the whole deal.</Fragment>
  </CtaBlock>
</BaseLayout>
