---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import PageIntro from '../../components/PageIntro.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import SectionCards from '../../components/SectionCards.astro';
import ChatExample from '../../components/ChatExample.astro';
import TeamSection from '../../components/TeamSection.astro';
import Faq from '../../components/Faq.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SITE, WA_MESSAGES } from '../../lib/site';
import { localBusinessSchema } from '../../lib/schema';

const whoCards = [
  {
    icon: '🎓',
    title: 'Students',
    body: 'New at UBB, UMF, UTCN, USAMV, or moving from another Romanian city. Housing, paperwork, budgets, first semester.',
    href: '/cluj/student-support/',
    linkLabel: 'Student support',
  },
  {
    icon: '🌍',
    title: 'New to Cluj, from abroad or anywhere',
    body: 'Here with a job offer, a family, a laptop for a season, or a whole new life. Different stories, same fifty questions.',
    href: '/cluj/foreigner-support/',
    linkLabel: 'Someone local to ask',
  },
  {
    icon: '❤️',
    title: 'Parents',
    body: "Your child is moving here and you'd sleep better knowing they have someone local to ask. So would they.",
    href: '/cluj/for-parents/',
    linkLabel: 'For parents',
  },
];

const faqItems = [
  {
    q: 'How does "pay what feels fair" actually work?',
    a: "Exactly like it sounds. You ask, we answer properly, and afterwards we send a payment link with a suggested range for that kind of help. You choose the amount. The service is new, and this is how we'd rather earn trust than with a paywall.",
  },
  {
    q: 'Do I have to pay before asking?',
    a: "No. While the service is new, you can ask first. If the answer helped, we'll send a payment link with a suggested range, and you choose what feels fair.",
  },
  {
    q: 'Can you find me an apartment?',
    a: "Not quite, we're not an agency and we don't have listings. What we do is make you good at finding one: we review listings you find, flag scams, tell you if prices are fair, help you choose a neighborhood, prep you for viewings, and help you understand the contract before you sign.",
  },
  {
    q: 'Is this only for students?',
    a: "Students are where we started and they keep a special place here, but we're for anyone new in Cluj: internationals, newcomers, and everyone in between. Same warm deal for everyone.",
  },
  {
    q: 'When is a price agreed in advance?',
    a: "Twice, always: anything complex enough to take real hours, and all in-person help (by the hour). If we haven't agreed it in advance, you don't owe it.",
  },
  {
    q: 'How quickly do you reply?',
    a: "During the day, usually within a few hours, often faster. We're a small team that prioritizes time-sensitive things, so tell us when something is urgent-ish. We're not an emergency line: in any real emergency, call 112 first.",
  },
];
---

<BaseLayout
  title="New in Cluj? Someone Local to Ask"
  description="Ask a real local person about living in Cluj-Napoca: housing, paperwork, prices, arrival, everyday problems. On WhatsApp, in English, within hours."
  path="/cluj/"
  schema={[localBusinessSchema()]}
>
  <Hero
    headline="New in Cluj? You know someone here now."
    image={{ src: '/images/student-cafe.webp', alt: 'Sitting at an outdoor café table on an old street in central Cluj', width: 820, height: 1093 }}
    immersive
  >
    <Fragment slot="lead">
      <p>
        Ask a real local person your questions about living in Cluj, on WhatsApp, in English.
        <strong class="text-ink">Housing, paperwork, prices, arrival, everyday problems.</strong>
      </p>
      <p class="font-display text-ink border-l-4 border-honey pl-4">
        Before you sign, pay, book, visit, decide, or panic — ask someone local.
      </p>
    </Fragment>
    <Fragment slot="cta">
      <WhatsAppButton message={WA_MESSAGES.general} label="Ask us one question" variant="primary" />
      <a href="#services" class="btn-fx inline-flex items-center gap-2 border-2 border-terra text-terra-deep hover:bg-terra-soft font-semibold rounded-full px-7 py-3">
        See what we help with
      </a>
    </Fragment>
    <Fragment slot="reassurance">
      A real person replies, usually within a few hours. While we're new, you choose what to pay.
    </Fragment>
  </Hero>

  <TrustStrip />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-12 md:mt-16 scroll-mt-24" id="services">
    <PageIntro title="What you can ask us about">
      <p>If it's part of living in Cluj, it's probably in here. If it isn't, ask anyway.</p>
    </PageIntro>
    <ServicesGrid />
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-14 md:mt-20">
    <PageIntro title="Who it's for">
      <p>One kind of help, three front doors. Nobody fits boxes perfectly. Just message us.</p>
    </PageIntro>
    <SectionCards cards={whoCards} columns={3} />
  </section>

  <section class="bg-paper border-y border-terra-soft mt-14 md:mt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-14">
      <div class="grid gap-10 md:grid-cols-2 items-start">
        <div data-reveal>
          <h2 class="text-3xl md:text-4xl font-semibold">How it works</h2>
          <ol class="mt-6 space-y-4 text-lg text-ink-soft">
            <li class="flex gap-3.5">
              <span class="shrink-0 w-8 h-8 rounded-full bg-honey-soft text-terra-deep font-display font-semibold flex items-center justify-center" aria-hidden="true">1</span>
              <span><strong class="text-ink">Message us on WhatsApp</strong> with any everyday question about living in Cluj.</span>
            </li>
            <li class="flex gap-3.5">
              <span class="shrink-0 w-8 h-8 rounded-full bg-honey-soft text-terra-deep font-display font-semibold flex items-center justify-center" aria-hidden="true">2</span>
              <span><strong class="text-ink">A local answers, properly</strong>: practical advice from a person who lives here, usually within a few hours.</span>
            </li>
            <li class="flex gap-3.5">
              <span class="shrink-0 w-8 h-8 rounded-full bg-honey-soft text-terra-deep font-display font-semibold flex items-center justify-center" aria-hidden="true">3</span>
              <span><strong class="text-ink">If it helped, pay what feels fair</strong>, we send a payment link with a suggested range (a small question is usually €3–5) and you choose. Bigger jobs and in-person help are agreed in advance.</span>
            </li>
          </ol>
          <p class="mt-6">
            <a href="/how-it-works/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">The full picture, including suggested ranges →</a>
          </p>
        </div>
        <ChatExample
          question="Hi! Found a studio in Mănăștur, 320€, landlord wants two months' deposit + first month before viewing. Normal?"
          answer="Paying anything before a viewing is a red flag here, please don't send money yet. Two months' deposit happens in Cluj but it's on the higher side. Send us the listing? We'll tell you what we'd check."
        />
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 mt-12 md:mt-16">
    <div class="bg-cream border border-terra-soft rounded-2xl p-5 sm:p-6 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal>
      <p class="font-semibold text-ink">Free guides for your first weeks:</p>
      <a href="/cluj/guides/cluj-airport-to-city-centre/" class="text-terra-deep font-medium underline underline-offset-4 hover:text-terra">Airport → centre</a>
      <a href="/cluj/guides/public-transport-cluj/" class="text-terra-deep font-medium underline underline-offset-4 hover:text-terra">Public transport</a>
      <a href="/cluj/guides/romanian-sim-card-foreigners/" class="text-terra-deep font-medium underline underline-offset-4 hover:text-terra">Romanian SIM card</a>
      <a href="/cluj/guides/open-bank-account-romania-foreigner/" class="text-terra-deep font-medium underline underline-offset-4 hover:text-terra">Bank account</a>
      <a href="/cluj/guides/" class="text-ink-soft font-medium underline underline-offset-4 hover:text-terra-deep">All guides →</a>
    </div>
  </section>

  <TeamSection />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 mt-12 md:mt-16">
    <div class="border-l-4 border-terra-soft pl-5 text-ink-soft space-y-3" data-reveal>
      <p>
        <strong class="text-ink">Plainly, what we're not:</strong> lawyers, doctors, police,
        university staff, or immigration officials. When a question needs one of those, we say
        so and help you find the right one. Not an emergency service either:
        <strong class="text-ink">in any real emergency, call 112 first.</strong>
      </p>
      <p>
        We don't promise to solve everything. We promise you'll always have someone local, kind,
        and competent to ask, and you'll always leave knowing what to do next.
        <a href="/how-it-works/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">More on how we work →</a>
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 mt-14 md:mt-20">
    <PageIntro title="Common questions" />
    <Faq items={faqItems} withSchema />
  </section>

  <CtaBlock
    headline="You don't have to figure out Cluj alone."
    message={WA_MESSAGES.general}
    label="Ask us one question"
  >
    <p>
      Every autumn and every Monday, someone new arrives in this city and learns everything the
      hard way. You don't have to.
    </p>
    <Fragment slot="footnote">One question, one honest local answer. If it helped, pay what feels fair.</Fragment>
  </CtaBlock>
</BaseLayout>
