---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { WA_MESSAGES } from '../lib/site';
import { organizationSchema, websiteSchema } from '../lib/schema';

const helpChips = [
  'Housing & renting',
  'Listing & rent checks',
  'Paperwork & offices',
  'Arrival & first week',
  'Everyday life',
  'In-person help',
];
---

<BaseLayout
  title="Practical Local Help in Cluj-Napoca"
  description="New in town? Ask someone who knows it. Practical local help with housing, paperwork, prices, and everyday problems — on WhatsApp. Available now in Cluj-Napoca."
  path="/"
  schema={[organizationSchema(), websiteSchema()]}
>
  <section class="bg-paper border-b border-terra-soft overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20 grid gap-8 md:gap-12 md:grid-cols-[1fr_1.25fr] items-center">
      <div>
        <h1 class="text-4xl md:text-5xl font-semibold text-balance">New in town? Ask someone who knows it.</h1>

        <p class="mt-5 text-lg text-ink-soft">
          Get practical local help with housing, paperwork, prices, services, and everyday
          problems — from a real person, on WhatsApp.
          <strong class="text-ink">Available now in Cluj-Napoca.</strong>
        </p>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="What we help with">
          {helpChips.map((chip) => (
            <li>
              <a href="/cluj/#services" class="inline-block bg-cream border border-terra-soft rounded-full px-3.5 py-1.5 text-sm font-medium text-ink-soft hover:border-terra hover:text-terra-deep transition-colors">
                {chip}
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/cluj/"
            class="inline-flex items-center gap-2 bg-terra hover:bg-terra-deep text-white font-semibold rounded-full px-7 py-3.5 transition-colors"
          >
            Get help in Cluj →
          </a>
          <WhatsAppButton message={WA_MESSAGES.general} label="Ask someone local" variant="secondary" />
        </div>
        <p class="mt-3 text-sm text-ink-soft">
          A real person replies, usually within a few hours. While we're new, you choose what to pay.
        </p>
      </div>

      <div class="relative overflow-hidden img-blob-hero aspect-[16/10] md:aspect-auto md:min-h-[620px] md:-my-4">
        <img
          src="/images/main.webp"
          alt="Smiling woman with a bike on an old-town street on a rainy day"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          width="1400"
          height="933"
        />
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-14 text-center">
    <p class="text-lg text-ink-soft">
      This is human help from people who actually live here — not a directory, an agency, or an
      app. One city at a time, done properly: for now, everything points to
      <a href="/cluj/" class="font-semibold text-terra-deep underline underline-offset-4 hover:text-terra">Cluj</a>.
    </p>
  </section>
</BaseLayout>
